# Required for production on Vercel.
# Use Supabase Transaction Pooler or another hosted PostgreSQL database.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Required for stable session signing across serverless instances.
# Generate a long random value and keep it secret.
NEXCRM_SESSION_SECRET="replace-with-a-long-random-secret"

# Supabase project metadata. Public values are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only values. Never expose this in frontend code.
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Optional.
# Set to disable only when using a local/non-SSL PostgreSQL database.
# PGSSLMODE="disable"

# Optional.
# Keep small for serverless environments.
PG_POOL_MAX="3"
