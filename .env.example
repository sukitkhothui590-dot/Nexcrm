# Required for production on Vercel.
# Use Vercel Postgres, Neon, Supabase, or another hosted PostgreSQL database.
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE"

# Required for stable session signing across serverless instances.
# Generate a long random value and keep it secret.
NEXCRM_SESSION_SECRET="replace-with-a-long-random-secret"

# Optional.
# Set to disable only when using a local/non-SSL PostgreSQL database.
# PGSSLMODE="disable"

# Optional.
# Keep small for serverless environments.
PG_POOL_MAX="3"
