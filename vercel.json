{
  "version": 2,
  "builds": [
    {
      "src": "api/router.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server.js",
          "src/**",
          "public/**"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/router.js?path=$1"
    },
    {
      "src": "^/(.*\\.(?:html|css|js|png|svg|ico|json))$",
      "dest": "/public/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/public/index.html"
    }
  ]
}
